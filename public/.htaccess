# Apache / LiteSpeed config for Hostinger. Every public route is prerendered
# to dist/<route>/index.html (scripts/prerender.mjs), so real files are served
# directly; only client-only areas fall back to the SPA shell.

ErrorDocument 404 /404.html

# Prerendered pages live in directories (/about/index.html). Stop Apache from
# 301-redirecting /about to /about/ so URLs match the canonical tags (no
# trailing slash).
DirectorySlash Off
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS + non-www (canonical host) in a single 301.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://abbasdigitalagency.com/$1 [R=301,L,NE]

  # Strip trailing slashes (/about/ → /about) to match canonicals.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Serve prerendered pages: /about → /about/index.html (internal rewrite).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]

  # Real files (assets, images, sitemap…) are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Client-only routes get the empty SPA shell with a 200 so React Router can
  # take over: the admin area, and blog posts published since the last build
  # (they get a prerendered page on the next deploy).
  RewriteRule ^admin(/.*)?$ /app-shell.html [L]
  RewriteRule ^blog/[^/]+$ /app-shell.html [L]

  # Anything else is a genuine 404 (served by ErrorDocument above with a real
  # 404 status — no soft-404 duplicates of the homepage).
</IfModule>

# Keep the SPA shell itself out of search results.
<Files "app-shell.html">
  <IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex"
  </IfModule>
</Files>

# Security headers.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Serve .txt as text/plain.
<IfModule mod_mime.c>
  AddType text/plain .txt
  AddType font/woff2 .woff2
</IfModule>

# Long-lived caching for hashed build assets and fonts.
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2?|ttf|png|jpe?g|webp|svg|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
